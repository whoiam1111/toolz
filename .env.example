# .env.local 로 복사해서 값을 채우세요. (Vercel 등 배포 환경에도 같은 키를 등록)

# Supabase 프로젝트 (대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되므로 금지
# 관리자 이메일 (쉼표로 여러 개). admins 테이블에 등록해도 관리자로 인정된다
ADMIN_EMAILS=
# 구독 페이지 할인/파트너 코드 (쉼표로 여러 개)
PROMO_CODES=
